
generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Store {
  id        String   @id @default(uuid())
  number    String   @unique
  name      String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employees Employee[]

  @@map("stores")
}

model Employee {
  id            String    @id @default(uuid())
  registration  String    @unique
  name          String
  hireDate      DateTime  @db.Date
  active        Boolean   @default(true)
  dismissalDate DateTime? @db.Date

  storeId String
  store   Store @relation(fields: [storeId], references: [id])

  movements UniformStockMovement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([storeId])
  @@map("employees")
}

model UniformProduct {
  id          String   @id @default(uuid())
  code        String   @unique
  name        String
  description String?
  active      Boolean  @default(true)

  variants UniformVariant[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("uniform_products")
}

model UniformSize {
  id        String   @id @default(uuid())
  name      String   @unique
  sortOrder Int      @default(0)
  active    Boolean  @default(true)

  variants UniformVariant[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("uniform_sizes")
}

model UniformVariant {
  id String @id @default(uuid())

  productId String
  product   UniformProduct @relation(fields: [productId], references: [id])

  sizeId String
  size   UniformSize @relation(fields: [sizeId], references: [id])

  stockNew       Int @default(0)
  stockUsed      Int @default(0)
  stockDiscarded Int @default(0)

  averageCost Decimal @default(0) @db.Decimal(12, 2)

  active Boolean @default(true)

  movements UniformStockMovement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productId, sizeId])
  @@index([sizeId])
  @@map("uniform_variants")
}

enum UniformMovementType {
  PURCHASE
  DELIVERY
  RETURN
  DISCARD
  ADJUSTMENT
}

enum UniformCondition {
  NEW
  USED
}

enum UniformMovementStatus {
  PENDING
  APPROVED
  REJECTED
}

model UniformStockMovement {
  id String @id @default(uuid())

  variantId String
  variant   UniformVariant @relation(fields: [variantId], references: [id])

  employeeId String?
  employee   Employee? @relation(fields: [employeeId], references: [id])

  type      UniformMovementType
  condition UniformCondition
  quantity  Int

  unitCost Decimal? @db.Decimal(12, 2)

  status UniformMovementStatus @default(PENDING)

  notes String?

  requestedBy String?
  approvedBy  String?

  approvedAt DateTime?
  rejectedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([variantId, createdAt])
  @@index([employeeId])
  @@index([status])
  @@map("uniform_stock_movements")
}

enum UserRole {
  ADMIN
  RH
}

model User {
  id String @id @default(uuid())

  name         String
  email        String @unique
  passwordHash String

  role   UserRole @default(RH)
  active Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}
